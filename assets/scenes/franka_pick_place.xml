<mujoco model="franka_pick_place">
  <!--
    Franka Panda pick-and-place scene.
    Robot: 7-DoF Franka Emika Panda (from MuJoCo Menagerie)
    Task: Pick a cube from random position, place in target zone.
  -->
  <compiler angle="radian" meshdir="../mujoco_menagerie/franka_emika_panda/assets/"
            autolimits="true" />
  <include file="../mujoco_menagerie/franka_emika_panda/panda.xml" />

  <statistic center="0.3 0 0.4" extent="0.8" />
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" />
  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1" />
  </visual>

  <worldbody>
    <!-- Floor -->
    <geom name="floor" type="plane" size="2 2 0.01" rgba="0.2 0.2 0.2 1"
          contype="1" conaffinity="1" />
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8" />

    <!-- Table -->
    <body name="table" pos="0.5 0 0.2">
      <geom name="table_surface" type="box" size="0.3 0.4 0.2"
            rgba="0.55 0.4 0.25 1" contype="1" conaffinity="1"
            friction="0.8 0.005 0.001" />
    </body>

    <!-- Cube to pick (free body) -->
    <body name="cube" pos="0.5 0.05 0.425">
      <freejoint name="cube_joint" />
      <geom name="cube_geom" type="box" size="0.015 0.015 0.015"
            mass="0.05" rgba="0.9 0.1 0.1 1" condim="4"
            friction="1.0 0.005 0.001" contype="1" conaffinity="1" />
    </body>

    <!-- Target zone (visual marker only) -->
    <site name="target_zone" pos="0.5 -0.15 0.405" size="0.04 0.04 0.002"
          rgba="0.1 0.8 0.1 0.4" type="box" />

    <!-- Overhead camera for observations -->
    <camera name="overhead" pos="0.5 0 1.3" xyaxes="1 0 0 0 -1 0" fovy="50" />

    <!-- Front camera (alternative view) -->
    <camera name="front" pos="1.0 0 0.7" xyaxes="0 1 0 -0.3 0 1" fovy="50" />
  </worldbody>
</mujoco>
